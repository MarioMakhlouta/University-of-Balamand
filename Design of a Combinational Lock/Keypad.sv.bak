module KeyPad(inout logic[3:0] col,row,
					input logic clk,rstN,
					output logic [3:0] regRow,regCol);

logic OEC,OER,keyPressed,CEC,CER;
typedef enum logic [3:0] {state0,state1 ,state2 ,state3,state4,state5,state6,state7,state8} state_t;
state_t state_next, state_reg;


assign col=OEC?4'b0:4'bZ;
assign row=OER?4'b0:4'bZ;
assign keyPressed=!(col[0]&col[1]&col[2]&col[3]);

always_ff @(posedge clk, negedge rstN)
		if(!rstN) begin
			state_reg<= state0;
		else 
			state_reg<= state_next;
			
			
always_comb begin
	state_next=state_reg;
	keypressed=1'b0;
	CEC=1'b0;
	CER=1'b0;
	OEC=1'b0;
	OER=1'b0;
	unique case (state_reg)
		state0: begin
			OER=1'b1;
			if(keyPressed)
				state_next=state1;
		end
		state1: 
			state_next=state2;
		state2: 
			state_next=state3;
		state3: begin
			CEC=1'b1;
			state_next=state4;
		end
		state4: begin
			OEC=1'b1;
			state_next=state5;
		end
		state5: begin
			CER=1'b1;
			state_next=state6;
		end
		state6: begin
			OER=1'b1;
			if(!keyPressed)
				state_next=state7;
		end
		state7: 
			state_next=state8;
		state8: 
			state_next=state0;
			

endmodule 
		

			